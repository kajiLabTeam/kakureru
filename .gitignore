# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/


# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets
# google-services.json / firebase_options.dart はFirebaseクライアント設定であり、
# Google公式の見解でも「公開されて問題ない」ものなので意図的に対象外にしている。
# アクセス制御はAPIキー制限とSecurity Rules側で行う（docs/firebase-api-key-restrictions.md）。
# 一方で以下はサーバー側の真の秘密情報なので除外する。
.env
.env.*
!.env.example
*firebase-adminsdk*.json
serviceAccountKey.json
*.pem
*.p12

# night-run: 実行中の状態ファイル・ログ(タスク内容や進捗を含む。定義自体はコミットする)
night-run/state/*
!night-run/state/.gitkeep
