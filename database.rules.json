{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "users": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "locations": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "visible": {
          ".write": false,
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
